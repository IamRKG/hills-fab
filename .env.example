# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env.local for local development, and add the same variables in your
# hosting provider's dashboard for production. NEVER commit real secrets.
# Variables starting with NEXT_PUBLIC_ are visible in the browser (public info only).
# ─────────────────────────────────────────────────────────────────────────────

# ── Public business details ─────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.example.com
NEXT_PUBLIC_COMPANY_NAME=
NEXT_PUBLIC_COMPANY_SHORT_NAME=
NEXT_PUBLIC_PHONE=
# International format, digits only (country code + number), e.g. 919876543210
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_EMAIL=
NEXT_PUBLIC_ADDRESS_STREET=
NEXT_PUBLIC_ADDRESS_CITY=
NEXT_PUBLIC_ADDRESS_REGION=
NEXT_PUBLIC_ADDRESS_POSTCODE=
# ISO country code, e.g. IN
NEXT_PUBLIC_ADDRESS_COUNTRY=
# City/region used in SEO titles, e.g. "Chennai"
NEXT_PUBLIC_PRIMARY_LOCATION=
# Optional exact Google Maps embed src (Google Maps → Share → Embed a map)
NEXT_PUBLIC_MAP_EMBED_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_YOUTUBE_URL=

# ── Enquiry delivery (configure at least one) — SERVER-ONLY SECRETS ────────
# Option 1: email via Resend (https://resend.com). Verify your sending domain first.
RESEND_API_KEY=
# Comma-separated list of recipients
ENQUIRY_TO_EMAIL=
# Must be on your verified Resend domain, e.g. "Website <enquiries@yourdomain.com>"
ENQUIRY_FROM_EMAIL=

# Option 2: webhook (Zapier / Make / n8n / Google Apps Script / CRM)
ENQUIRY_WEBHOOK_URL=
# Optional: signs the JSON body; header X-Signature-SHA256 = HMAC-SHA256(body, secret)
ENQUIRY_WEBHOOK_SECRET=

# ── Spam protection (optional but recommended) ─────────────────────────────
# Cloudflare Turnstile — https://dash.cloudflare.com → Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Max enquiries per IP per 10 minutes (default 5)
ENQUIRY_RATE_LIMIT=5
